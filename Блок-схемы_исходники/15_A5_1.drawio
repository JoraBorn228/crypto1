юч UTF-8 → первые 8 байт → 64 бита; текст → биты" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#174a75;fontSize=22;rounded=0;" vertex="1" parent="1"><mxGeometry x="30" y="696" width="460" height="120" as="geometry" /></mxCell><mxCell id="9" value="Проверить ввод; ключ → 64 бита; hex-шифртекст → биты" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#174a75;fontSize=22;rounded=0;" vertex="1" parent="1"><mxGeometry x="1110" y="696" width="460" height="120" as="geometry" /></mxCell><mxCell id="10" value="Кадр → 22 бита; длина гаммы = длина данных в битах" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#174a75;fontSize=22;rounded=0;" vertex="1" parent="1"><mxGeometry x="500" y="840" width="600" height="100" as="geometry" /></mxCell><mxCell id="11" value="Обнулить R1 (19), R2 (22), R3 (23)" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#174a75;fontSize=22;rounded=0;" vertex="1" parent="1"><mxGeometry x="500" y="952" width="600" height="80" as="geometry" /></mxCell><mxCell id="12" value="64 бита ключа: XOR младшего разряда; 64 такта всех регистров" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#174a75;fontSize=22;rounded=0;" vertex="1" parent="1"><mxGeometry x="500" y="1048" width="600" height="110" as="geometry" /></mxCell><mxCell id="13" value="22 бита кадра: XOR младшего разряда; 22 такта всех регистров" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#174a75;fontSize=22;rounded=0;" vertex="1" parent="1"><mxGeometry x="500" y="1168" width="600" height="100" as="geometry" /></mxCell><mxCell id="14" value="100 холостых тактов: majority; сдвиг совпавших регистров" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#174a75;fontSize=22;rounded=0;" vertex="1" parent="1"><mxGeometry x="500" y="1280" width="600" height="110" as="geometry" /></mxCell><mxCell id="15" value="Для кажд