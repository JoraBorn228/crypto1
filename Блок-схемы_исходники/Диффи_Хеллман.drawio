<mxfile host="app.diagrams.net" version="32.6.1" type="device"><diagram id="dh-701" name="Диффи—Хеллман"><mxGraphModel dx="1900" dy="1720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1720" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="Начало" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#1f4e79;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="760" y="30" width="300" height="70" as="geometry" /></mxCell><mxCell id="pub" value="Ввести публичные параметры&lt;br&gt;n, a" style="parallelogram;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#1f4e79;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="660" y="140" width="500" height="100" as="geometry" /></mxCell><mxCell id="vpub" value="n — простое?&lt;br&gt;1 &lt; a &lt; n?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="760" y="290" width="300" height="120" as="geometry" /></mxCell><mxCell id="perr" value="Сообщить об ошибке&lt;br&gt;параметров" style="parallelogram;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#1f4e79;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="90" y="305" width="360" height="90" as="geometry" /></mxCell><mxCell id="menu1" value="Возврат в меню" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#1f4e79;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="150" y="445" width="240" height="70" as="geometry" /></mxCell><mxCell id="keys" value="Ввести секретные ключи&lt;br&gt;K_A и K_B (2…n−1)" style="parallelogram;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#1f4e79;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="660" y="480" width="500" height="100" as="geometry" /></mxCell><mxCell id="vkeys" value="Оба ключа допустимы?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="760" y="630" width="300" height="120" as="geometry" /></mxCell><mxCell id="kerr" value="Ключи неверны;&lt;br&gt;повторить ввод" style="parallelogram;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#1f4e79;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="70" y="645" width="400" height="90" as="geometry" /></mxCell><mxCell id="pubcalc" value="Y_A = a^K_A mod n&lt;br&gt;Y_B = a^K_B mod n" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e79;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="690" y="810" width="440" height="80" as="geometry" /></mxCell><mxCell id="exchange" value="Обменяться Y_A и Y_B&lt;br&gt;по открытому каналу" style="parallelogram;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#1f4e79;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="660" y="925" width="500" height="90" as="geometry" /></mxCell><mxCell id="kcalc" value="K_A = Y_B^K_A mod n&lt;br&gt;K_B = Y_A^K_B mod n" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e79;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="660" y="1055" width="500" height="100" as="geometry" /></mxCell><mxCell id="equal" value="K_A = K_B?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="760" y="1200" width="300" height="120" as="geometry" /></mxCell><mxCell id="mismatch" value="Секреты не совпали;&lt;br&gt;повторить ввод ключей" style="parallelogram;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#1f4e79;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1200" y="1215" width="400" height="90" as="geometry" /></mxCell><mxCell id="one" value="Общий секрет равен 1?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeCol