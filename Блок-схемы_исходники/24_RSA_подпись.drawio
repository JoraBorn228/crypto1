<mxfile host="app.diagrams.net" version="24.7.17"><diagram name="RSA подпись" id="rsa-signature"><mxGraphModel dx="1600" dy="2400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2400" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="Начало" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#174a75;fontSize=16;" vertex="1" parent="1"><mxGeometry x="600" y="25" width="400" height="70" as="geometry" /></mxCell><mxCell id="3" value="Ввод p, q, e" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#174a75;fontSize=16;" vertex="1" parent="1"><mxGeometry x="500" y="130" width="600" height="100" as="geometry" /></mxCell><mxCell id="4" value="p и q простые и разные; 1 &lt; e &lt; φ(N); НОД(e, φ(N)) = 1; N &gt; 32?" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c99a00;fontSize=16;" vertex="1" parent="1"><mxGeometry x="540" y="285" width="520" height="150" as="geometry" /></mxCell><mxCell id="5" value="Сообщить об ошибке; повторить ввод" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#174a75;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="320" width="350" height="85" as="geometry" /></mxCell><mxCell id="6" value="Вычислить N = p·q; φ(N) = (p−1)(q−1); D = inverse(E, phi(N))" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#174a75;fontSize=16;" vertex="1" parent="1"><mxGeometry x="500" y="510" width="600" height="130" as="geometry" /></mxCell><mxCell id="7" value="Меню: 1 — ключи; 2 — подписать; 3 — проверить; 4 — выход" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#174a75;fontSize=16;" vertex="1" parent="1"><mxGeometry x="600" y="720" width="400" height="85" as="geometry" /></mxCell><mxCell id="8" value="Выбор пользователя" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c99a00;fontSize=16;" vertex="1" parent="1"><mxGeometry x="650" y="875" width="300" height="125" as="geometry" /></mxCell><mxCell id="9" value="Ввести сообщение M" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#174a75;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="1080" width="470" height="90" as="geometry" /></mxCell><mxCell id="10" value="Подготовить текст; вычислить h = H(M) по алгоритму программы" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#174a75;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="1220" width="470" height="110" as="geometry" /></mxCell><mxCell id="11" value="Вычислить S = pow(h, D, N)" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#174a75;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="1380" width="470" height="100" as="geometry" /></mxCell><mxCell id="12" value="Вывести подпись S" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#174a75;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="1530" width="470" height="85" as="geometry" /></mxCell><mxCell id="13" value="Повторно вычислить хэш h = H(M)" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#174a75;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1050" y="1080" width="470" height="110" as="geometry" /></mxCell><mxCell id="14" value="Вычислить h1 = pow(S, E, N)" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#174a75;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1050" y="1240" width="470" height="100" as="geometry" /></mxCell><mxCell id="15" value="h1 = h?" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c99a00;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1110" y="1400" width="350" height="125" as="geometry" /></mxCell><mxCell id="16" value="Подпись верна" style="shape=parallelogram;whiteSpace=wrap;html=1;fill