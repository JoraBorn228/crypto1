<mxfile host="app.diagrams.net" modified="2026-10-29T12:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="17_Вертикальная_перестановка" name="Рисунок 17 — Вертикальная перестановка"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1610" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="Начало" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;strokeWidth=2;strokeColor=#1f4e79;fillColor=#ffffff;aspect=fixed;shape=ellipse;" vertex="1" parent="1"><mxGeometry x="520" y="20" width="160" height="55" as="geometry" /></mxCell><mxCell id="3" value="Меню: 1 шифровать; 2 расшифровать; 3&lt;br&gt;выход" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;strokeWidth=2;strokeColor=#1f4e79;fillColor=#eaf2f8;shape=parallelogram;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="500" height="85" as="geometry" /></mxCell><mxCell id="4" value="Выбор" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;strokeWidth=2;strokeColor=#bf9000;fillColor=#fff2cc;perimeter=rhombusPerimeter;shape=rhombus;" vertex="1" parent="1"><mxGeometry x="520" y="225" width="160" height="95" as="geometry" /></mxCell><mxCell id="5" value="Выход" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;strokeWidth=2;strokeColor=#1f4e79;fillColor=#ffffff;aspect=fixed;shape=ellipse;" vertex="1" parent="1"><mxGeometry x="950" y="245" width="150" height="55" as="geometry" /></mxCell><mxCell id="6" value="Ввести текст/шифротекст и&lt;br&gt;ключевое слово" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;strokeWidth=2;strokeColor=#1f4e79;fillColor=#eaf2f8;shape=parallelogram;" vertex="1" parent="1"><mxGeometry x="390" y="380" width="420" height="80" as="geometry" /></mxCell><mxCell id="7" value="Ключ состоит&lt;br&gt;только из&lt;br&gt;букв?" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;strokeWidth=2;strokeColor=#bf9000;fillColor=#fff2cc;perimeter=rhombusPerimeter;shape=rhombus;" vertex="1" parent="1"><mxGeometry x="500" y="520" width="200" height="110" as="geometry" /></mxCell><mxCell id="8" value="Сообщить об ошибке и&lt;br&gt;запросить ключ снова" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;strokeWidth=2;strokeColor=#1f4e79;fillColor=#eaf2f8;shape=parallelogram;" vertex="1" parent="1"><mxGeometry x="65" y="540" width="330" height="75" as="geometry" /></mxCell><mxCell id="9" value="Пронумеровать повторы и упорядочить&lt;br&gt;столбцы по буквам ключа" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;strokeWidth=2;strokeColor=#1f4e79;fillColor=#eaf2f8;shape=rect;" vertex="1" parent="1"><mxGeometry x="390" y="700" width="420" height="90" as="geometry" /></mxCell><mxCell id="10" value="Шифрование: удалить пробелы, перевести&lt;br&gt;в верхний регистр; прочие символы&lt;br&gt;сохранить" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;strokeWidth=2;strokeColor=#1f4e79;fillColor=#eaf2f8;shape=rect;" vertex="1" parent="1"><mxGeometry x="50" y="875" width="420" height="100" as="geometry" /></mxCell><mxCell id="11" value="Вычислить строки = ceil(длина / число&lt;br&gt;столбцов); заполнить таблицу по&lt;br&gt;строкам без добавочных символов" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;strokeWidth=2;strokeColor=#1f4e79;fillColor=#eaf2f8;shape=rect;" vertex="1" parent="1"><mxGeometry x="50" y="1040" width="420" height="110" as="geometry" /></mxCell><mxCell id="12" value="Считать столбцы по порядку ключа,&lt;br&gt;пропуская пустые клетки" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;strokeWidth=2;strokeColor=#1f4e79;fillColor=#eaf2f8;shape=rect;" vertex="1" parent="1"><mxGeometry x="50" y="1210" width="420" height="80" as="geometry" /></mxCell><mxCell id="13" value="Расшифрование: вычислить число строк и&lt;br&gt;длину каждого столбца с учётом неполной&lt;br&gt;последней строки" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;strokeWidth=2;strokeColor=#1f4e79;fillColor=#eaf2f8;shape=rect;" vertex="1" parent="1"><mxGeometry x="730" y="875" width="430" height="105" as="geometry" /></mxCell><mxCell id="14" value="Заполнить столбцы шифротекстом в&lt;br&gt;порядке ключа" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;strokeWidth=2;strokeColor=#1f4e79;fillColor=#eaf2f8;shape=rect;" vertex="1" parent="1"><mxGeometry x="730" y="1045" width="430" height="80" as="geometry" /></mxCell><mxCell id="15" value="Считать заполненную таблицу по строкам,&lt;br&gt;пропуская пустые клетки" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;strokeWidth=2;strokeColor=#1f4e79;fillColor=#eaf2f8;shape=rect;" vertex="1" parent="1"><mxGeometry x="730" y="1210" width="430" height="80" as="geometry" /></mxCell><mxCell id="16" value="Вывести результат" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;strokeWidth=2;strokeColor=#1f4e79;fillColor=#eaf2f8;shape=parallelogram;" vertex="1" parent="1"><mxGeometry x="420" y="1400" width="360" height="70" as="geometry" /></mxCell><mxCell id="17" value="Возврат в меню" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;strokeWidth=2;strokeColor=#1f4e79;fillColor=#ffffff;aspect=fixed;shape=ellipse;" vertex=